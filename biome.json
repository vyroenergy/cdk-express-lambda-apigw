{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.next",
      "!**/coverage",
      "!**/*.svg",
      "!**/*.html",
      "!**/src/types/graphql.ts",
      "!**/src/types/graphql",
      "!**/src/gql",
      "!**/graphql.schema.json",
      "!**/cypress/support/graphql-operations.ts",
      "!clients",
      "!**/src/clients",
      "!**/test-fixtures",
      "!**/dep-graph.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noTsIgnore": "off",
        "noDoubleEquals": "warn",
        "noPrototypeBuiltins": "off",
        "noUnknownAtRules": "off",
        "noControlCharactersInRegex": "warn",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn",
        "noImplicitAnyLet": "warn",
        "noNonNullAssertedOptionalChain": "warn",
        "noAssignInExpressions": "warn",
        "noShadowRestrictedNames": "warn",
        "noRedeclare": "warn",
        "noFallthroughSwitchClause": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedVariables": "warn",
        "useHookAtTopLevel": "warn",
        "useJsxKeyInIterable": "warn",
        "noChildrenProp": "warn",
        "noUnsafeOptionalChaining": "warn",
        "noInvalidUseBeforeDeclaration": "warn",
        "useValidTypeof": "warn",
        "noUnsafeFinally": "warn",
        "noSelfAssign": "warn",
        "noEmptyPattern": "warn",
        "noConstantCondition": "warn",
        "noUnusedImports": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "a11y": {
        "useButtonType": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "noSvgWithoutTitle": "warn",
        "useIframeTitle": "warn",
        "useAltText": "warn",
        "useHtmlLang": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": {
    "formatter": {
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.js"],
      "javascript": {
        "globals": ["exports", "require", "module", "process", "__dirname"]
      }
    },
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "javascript": {
        "globals": []
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
